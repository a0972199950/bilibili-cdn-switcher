{
  "name": "bilibili-cdn-switcher-tools",
  "private": true,
  "type": "module",
  "description": "Dev tooling only (dependencies for the Node scripts under scripts/); not the extension itself. The extension source lives in src/.",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "build": "node scripts/build.mjs",
    "build:safari": "node scripts/build-safari.mjs",
    "package": "node scripts/package.mjs",
    "gen-icons": "node scripts/gen-icons.mjs",
    "changelog:validate": "node scripts/changelog.mjs validate",
    "publish-stores": "node scripts/publish-stores.mjs",
    "test:whats-new": "node scripts/test-whats-new.mjs",
    "invite:create": "node scripts/invite.mjs create",
    "invite:delete": "node scripts/invite.mjs delete",
    "invite:show": "node scripts/invite.mjs show",
    "events:show": "node scripts/events.mjs show",
    "lottery:add": "node scripts/lottery.mjs add",
    "lottery:update": "node scripts/lottery.mjs update",
    "lottery:preview": "node scripts/lottery.mjs preview",
    "lottery:end": "node scripts/lottery.mjs end",
    "lottery:show": "node scripts/lottery.mjs show",
    "private:setup": "node scripts/private-repo.mjs setup",
    "private:push": "node scripts/private-repo.mjs push",
    "private:pull": "node scripts/private-repo.mjs pull",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "worker:deploy": "wrangler deploy --config tools/report-worker/wrangler.toml",
    "worker:dev": "wrangler dev --config tools/report-worker/wrangler.toml",
    "worker:opens": "node tools/report-worker/opens.mjs",
    "admin": "npm --prefix admin run dev"
  },
  "devDependencies": {
    "jsdom": "^27.0.1",
    "jszip": "^3.10.1",
    "puppeteer": "^25.5.0",
    "sharp": "^0.35.3",
    "wrangler": "^4.149.0"
  }
}

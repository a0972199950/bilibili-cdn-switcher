{
  "name": "bilibili-cdn-switcher-tools",
  "private": true,
  "type": "module",
  "description": "Dev tooling only (dependencies for the Node scripts under scripts/); not the extension itself. The extension source lives in src/.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:safari": "node scripts/build-safari.mjs",
    "gen-icons": "node scripts/gen-icons.mjs",
    "capture-screenshots": "node scripts/capture-screenshots.mjs",
    "changelog:validate": "node scripts/changelog.mjs validate",
    "release:prepare": "node scripts/release.mjs prepare",
    "publish-stores": "node scripts/publish-stores.mjs",
    "test:whats-new": "node scripts/test-whats-new.mjs",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "puppeteer": "^25.5.0",
    "sharp": "^0.35.3"
  }
}

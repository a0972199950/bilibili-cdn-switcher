
# OS / 編輯器
Thumbs.db
desktop.ini
.DS_Store
.vscode/

# Node（scripts/capture-screenshots.mjs 用）
node_modules/

# 本機密鑰：截圖用的 bilibili 登入 cookie（含 SESSDATA，等同帳號憑證，絕對不要 commit）
.env.local

# Safari / Xcode 暫存檔
safari/*/build/
safari/*/.build/
safari/*.xcodeproj/xcuserdata/
safari/*.xcworkspace/xcuserdata/
safari/*.xcworkspace/xcshareddata/
safari/*/DerivedData/
/
# 瀏覽器自動化工具（Playwright MCP）的暫存紀錄
.playwright-mcp/

# /cdn-speedtest 測速結果（含當地出口 IP）
cdn-speedtest-results/


# Python 快取
__pycache__/

# 研究資料與規格，只留本機
research/
spec/

# 發版產物（npm run package；/release 會上傳到 GitHub Release）
release/


# OS / 編輯器
Thumbs.db
desktop.ini
.DS_Store
.vscode/

# Node（scripts/*.mjs 用）
node_modules/

# 本機密鑰：截圖用的 bilibili 登入 cookie（含 SESSDATA，等同帳號憑證，絕對不要 commit）
.env.local

# Safari / Xcode 暫存檔
safari/*/build/
safari/*/.build/
safari/*.xcodeproj/xcuserdata/
safari/*.xcworkspace/xcuserdata/
safari/*.xcworkspace/xcshareddata/
safari/*/DerivedData/
/
# 瀏覽器自動化工具（Playwright MCP）的暫存紀錄
.playwright-mcp/

# /cdn-speedtest 測速結果（含當地出口 IP）
cdn-speedtest-results/


# Python 快取
__pycache__/

# 研究資料與規格，只留本機
research/
spec/

# 發版產物（npm run package；/release 會上傳到 GitHub Release）
release/

# Cloudflare Worker 本機密鑰 / 暫存
tools/report-worker/.dev.vars
tools/report-worker/.wrangler/

# 推廣文章、論壇帳號（含密碼）與經營紀錄，只留本機
promotions/

# /growth-report 的成長報告與各商店後台匯出的原始數據（含評論者名稱），只留本機
/growth-report/

# 自己用的 Claude Code skill（發版、測速分析、論壇經營、成長報告…）與本機設定，只進私人 repo
.claude/skills/
.claude/settings.local.json

# 商店上架文案、截圖與宣傳圖，只進私人 repo
/store/

# 私人 repo（scripts/private-repo.mjs）：資料庫本身，與 setup 時被覆蓋前的本機檔案備份
/.git-private/
/.private-restore-backup/

# 本機後台（Next.js，只在 localhost 跑、不部署），只進私人 repo
/admin/
